#!/usr/bin/env zsh

{{ if eq .chezmoi.os "linux" -}}
# Source shared utilities from chezmoi source directory
source "{{ .chezmoi.sourceDir }}/dot_local/lib/chezmoi/utils.sh"

# Install basic packages
install_packages git curl wget
{{ else -}}
brew bundle --no-lock --file=/dev/stdin <<EOF
brew "awscli"
brew "bat"
brew "ripgrep"
brew "coreutils"
brew "gpg"
brew "gawk"

cask "dbeaver-community"
cask "docker"
cask "figma"
cask "font-fira-code-nerd-font"
cask "google-chrome"
cask "google-chrome@canary"
cask "iterm2"
cask "microsoft-outlook"
cask "microsoft-teams"
cask "obsidian"
cask "postgres-unofficial"
cask "signal"
cask "slack"
cask "spotify"
cask "raycast"
cask "visual-studio-code"
cask "vivaldi"
cask "zoom"
hidutil property --set "$(cat ~/.config/osx/keyboard_remap.json)"
EOF
{{ end -}}

[[ -d ~/.antidote ]] || git clone https://github.com/mattmc3/antidote ~/.antidote

. ~/.antidote/antidote.zsh

touch .custom.zsh
