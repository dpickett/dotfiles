{{- /* chezmoi:modify-template */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $statusLine := dict "type" "command" "command" `bash "$HOME/.claude/statusline.sh"` -}}
{{ $settings | setValueAtPath "statusLine" $statusLine | toPrettyJson }}
