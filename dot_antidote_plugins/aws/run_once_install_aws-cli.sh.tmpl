#!/usr/bin/env bash

echo "installing aws cli"
cd ~

{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "nixos") }}
# NixOS: the upstream installer ships binaries built for FHS distros
source "{{ .chezmoi.sourceDir }}/dot_local/lib/chezmoi/utils.sh"
install_packages awscli2
{{- else if eq .chezmoi.os "linux" }}
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
unzip awscliv2.zip
sudo ./aws/install
rm ./awscliv2.zip
rm -rf aws
{{- else -}}
curl "https://awscli.amazonaws.com/AWSCLIV2.pkg" -o "AWSCLIV2.pkg"
sudo installer -pkg AWSCLIV2.pkg -target /
rm AWSCLIV2.pkg
{{- end }}

mkdir -p $HOME/.aws
