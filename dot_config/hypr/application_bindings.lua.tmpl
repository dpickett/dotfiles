{{- /* Arch and nixpkgs ship these apps under different binary names. */ -}}
{{- $vivaldi := "vivaldi" -}}
{{- if lookPath "vivaldi-stable" }}{{ $vivaldi = "vivaldi-stable" }}{{ end -}}
{{- $spotify := "spotify" -}}
{{- if lookPath "spotify-launcher" }}{{ $spotify = "spotify-launcher" }}{{ end -}}
hl.bind("SUPER + ALT + B", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh vivaldi-stable {{ $vivaldi }}"),
    { description = "Browser" })
hl.bind("SUPER + ALT + M", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Spotify {{ $spotify }}"),
    { description = "Music" })
hl.bind("SUPER + ALT + W", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Signal signal-desktop"),
    { description = "Signal" })
hl.bind("SUPER + ALT + P", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Slack slack"),
    { description = "Slack" })
hl.bind("SUPER + ALT + F", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Nautilus nautilus"),
    { description = "File explorer" })
hl.bind("SUPER + ALT + K", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Obsidian obsidian"),
    { description = "Obsidian" })
hl.bind("SUPER + ALT + N", hl.dsp.exec_cmd("waydroid show-full-ui"),
    { description = "Waydroid" })
hl.bind("SUPER + ALT + O", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Chromium chromium"),
    { description = "Chrome" })
hl.bind("SUPER + ALT + T", hl.dsp.exec_cmd("~/.local/bin/herdr-focus"),
    { description = "Herdr" })

hl.bind("SUPER + SHIFT + space", hl.dsp.exec_cmd("pkill -USR2 -x handy"),
    { description = "Voice to text (toggle)" })
hl.bind("SUPER + SHIFT + period", hl.dsp.exec_cmd("pkill -USR2 -x handy"),
    { description = "Voice to text (toggle)" })

hl.bind("SUPER + ALT + R", hl.dsp.exec_cmd("~/.config/hypr/scripts/fix-monitors.sh"),
    { description = "Fix monitors" })

-- SSB Binds
hl.bind("SUPER + ALT + G",
    hl.dsp.exec_cmd('launch-os-launch-or-focus.sh mail.google.com "{{ $vivaldi }} --app=https://mail.google.com"'),
    { description = "Gmail" })
hl.bind("SUPER + ALT + 0",
    hl.dsp.exec_cmd('launch-os-launch-or-focus.sh calendar.google.com "{{ $vivaldi }} --app=https://calendar.google.com"'),
    { description = "Google Calendar" })
hl.bind("SUPER + ALT + Z",
    hl.dsp.exec_cmd('launch-os-launch-or-focus.sh zoom.us "{{ $vivaldi }} --app=https://zoom.us/wc"'),
    { description = "Zoom" })

-- Ergonomic remap: home-row focus, and a leader submap on right Alt (keyd
-- remaps it to F13). Old chords stay bound during the transition.

hl.unbind("SUPER + J") -- hl.bind stacks rather than replaces

for key, dir in pairs({ H = "l", J = "d", K = "u", L = "r" }) do
    hl.bind("SUPER + " .. key, hl.dsp.focus({ direction = dir }),
        { description = "Move focus " .. dir })
    hl.bind("SUPER + SHIFT + " .. key, hl.dsp.window.swap({ direction = dir }),
        { description = "Swap window " .. dir })
end

hl.bind("SUPER + S", hl.dsp.layout("togglesplit"), { description = "Toggle split" })
hl.bind("SUPER + Tab", hl.dsp.focus({ workspace = "previous" }),
    { description = "Previous workspace" })

local function leader(key, dispatcher, description)
    hl.bind(key, function()
        hl.dispatch(dispatcher)
        hl.dispatch(hl.dsp.submap("reset"))
    end, { description = description })
end

hl.define_submap("leader", function()
    leader("B", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh vivaldi-stable {{ $vivaldi }}"), "Browser")
    leader("M", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Spotify {{ $spotify }}"), "Music")
    leader("W", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Signal signal-desktop"), "Signal")
    leader("P", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Slack slack"), "Slack")
    leader("F", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Nautilus nautilus"), "File explorer")
    leader("K", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Obsidian obsidian"), "Obsidian")
    leader("N", hl.dsp.exec_cmd("waydroid show-full-ui"), "Waydroid")
    leader("O", hl.dsp.exec_cmd("launch-os-launch-or-focus.sh Chromium chromium"), "Chrome")
    leader("T", hl.dsp.exec_cmd("~/.local/bin/herdr-focus"), "Herdr")
    leader("R", hl.dsp.exec_cmd("~/.config/hypr/scripts/fix-monitors.sh"), "Fix monitors")
    leader("G", hl.dsp.exec_cmd('launch-os-launch-or-focus.sh mail.google.com "{{ $vivaldi }} --app=https://mail.google.com"'), "Gmail")
    leader("C", hl.dsp.exec_cmd('launch-os-launch-or-focus.sh calendar.google.com "{{ $vivaldi }} --app=https://calendar.google.com"'), "Google Calendar")
    leader("Z", hl.dsp.exec_cmd('launch-os-launch-or-focus.sh zoom.us "{{ $vivaldi }} --app=https://zoom.us/wc"'), "Zoom")

    for ws = 1, 10 do
        leader("code:" .. (ws + 9), hl.dsp.focus({ workspace = ws }),
            "Switch to workspace " .. ws)
    end

    hl.bind("catchall", hl.dsp.submap("reset"), { description = "Exit leader" })
end)

-- code:191 not "F13": layout us gives FK13 no keysym, so the name never matches.
hl.bind("code:191", hl.dsp.submap("leader"), { description = "Leader" })
