-- Load a config file without letting a missing or broken one abort the rest of
-- this file. Hyprland's require() is already scope-isolated per file, but a
-- module that fails to resolve at all raises here.
local function source(path)
    local ok, err = pcall(require, path)
    if not ok then
        print("hyprland.lua: could not load " .. path .. ": " .. tostring(err))
    end
end

{{ if stat "/etc/launcher-os/hypr" -}}
local launcher_os = "/etc/launcher-os/hypr/"
{{- else -}}
local launcher_os = "/usr/local/share/launcher-os/default/hypr/"
{{- end }}

source(launcher_os .. "autostart.lua")
source(launcher_os .. "env.lua")
source(launcher_os .. "bindings.lua")

source(launcher_os .. "bindings/wm.lua")
source(launcher_os .. "bindings/media.lua")

-- monitors.lua is generated by hyprmoncfg and is absent until a profile is applied.
source("monitors")
source("application_bindings")
source("lid-switch")

hl.on("hyprland.start", function()
    hl.exec_cmd("handy --start-hidden")
end)

hl.layer_rule({
    match = { namespace = "vicinae" },
    blur = true,
    ignore_alpha = 0,
    no_anim = true,
})

hl.config({
    input = {
        kb_options = "caps:ctrl_modifier",
    },

    general = {
        gaps_in = 5,
        gaps_out = 10,
        border_size = 2,
    },

    misc = {
        focus_on_activate = true,
    },
})

hl.window_rule({ match = { class = "Waydroid" }, float = true })
hl.window_rule({ match = { class = "^(com.mitchellh.ghostty)$" }, opacity = "0.8 0.8" })
